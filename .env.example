# Copy to .env.local and fill in values as needed.
# The booking flow works with zero configuration: it falls back to a local
# SQLite file at .data/woori-aroma.sqlite3 and mock payment/notification
# providers. Nothing below is required for local development.

# --- Database (lib/db/client.ts) -------------------------------------
# SQLite via Node's built-in node:sqlite. Defaults to .data/woori-aroma.sqlite3
# (gitignored) if unset. Set to an absolute path to use a different location,
# or ":memory:" for an ephemeral database (used automatically by the test suite).
# DATABASE_FILE=

# How long a reservation HOLD stays reserved before it's eligible to be
# reused by another customer (see lib/repositories/reservationRepository.ts).
# Defaults to 10 minutes if unset.
# BOOKING_HOLD_MINUTES=10

# --- Notifications (lib/notifications) -------------------------------
# All notification env vars are server-only — never prefix with NEXT_PUBLIC_.
# Every provider below degrades cleanly ("provider_not_configured", logged,
# never a crash) when its variables are unset, so none of this is required
# for local development.

# Email — Resend (https://resend.com). Used for confirmation/update/
# cancellation/reminder emails, sent to every customer with an email address.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Korean customers — SOLAPI (https://solapi.com), Kakao AlimTalk first,
# automatic SMS fallback on Kakao failure. SOLAPI_KAKAO_TEMPLATE_ID must be
# an approved AlimTalk template ID from the SOLAPI/Kakao channel console.
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER_NUMBER=
# SOLAPI_KAKAO_PFID=
# SOLAPI_KAKAO_TEMPLATE_ID=

# International customers — Meta WhatsApp Cloud API
# (https://developers.facebook.com/docs/whatsapp/cloud-api). Only sent to
# customers who explicitly opted in on the booking form. Template names must
# be pre-approved in Meta Business Manager.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_TEMPLATE_CONFIRMATION=
# WHATSAPP_TEMPLATE_REMINDER=
# WHATSAPP_TEMPLATE_UPDATE=
# WHATSAPP_TEMPLATE_CANCELLATION=

# Store administrator alerts — Telegram Bot API. Fires on every new/updated/
# cancelled reservation, regardless of customer channel.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=

# 24h reminder scheduler (app/api/cron/reminders/route.ts). Required in
# production: the route rejects requests without this bearer token so the
# reminder job can't be triggered by anyone who finds the URL. Point any
# external scheduler (Vercel Cron, a server crontab, GitHub Actions, etc.) at
# this route with `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=

# --- Payment (deposit charge) ---------------------------------------
# Not yet integrated — see lib/payment. Example for a future Toss Payments setup:
# TOSS_SECRET_KEY=
