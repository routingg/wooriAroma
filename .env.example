# Copy to .env.local and fill in values as needed.
# The booking flow works with zero configuration: it falls back to a local
# SQLite file at .data/woori-aroma.sqlite3 and mock payment/notification
# providers. Nothing below is required for local development.

# --- Database (lib/db/client.ts) -------------------------------------
# SQLite via Node's built-in node:sqlite. Defaults to .data/woori-aroma.sqlite3
# (gitignored) if unset. Set to an absolute path to use a different location,
# or ":memory:" for an ephemeral database (used automatically by the test suite).
# DATABASE_FILE=

# How long a reservation HOLD stays reserved before it's eligible to be
# reused by another customer (see lib/repositories/reservationRepository.ts).
# Defaults to 10 minutes if unset.
# BOOKING_HOLD_MINUTES=10

# --- Email (booking confirmation) ---------------------------------
# Used by a future server-side notification route (see lib/notifications).
# Must NEVER be read from client-side code.
# RESEND_API_KEY=

# --- SMS / WhatsApp (booking confirmation) -------------------------
# Provider not yet chosen — placeholder names only.
# NOTIFICATIONS_SMS_PROVIDER=
# NOTIFICATIONS_SMS_API_KEY=

# --- Payment (deposit charge) ---------------------------------------
# Not yet integrated — see lib/payment. Example for a future Toss Payments setup:
# TOSS_SECRET_KEY=
