# Copy to .env.local and fill in values as needed.
# The booking flow works with zero configuration for the DB and mock
# payment/notification providers. Nothing below is required for local
# development.

# --- Database (lib/db/client.ts) -------------------------------------
# Cloudflare D1, reached via the "DB" binding declared in wrangler.jsonc —
# not an env var. `next dev` gets a local D1 binding automatically via
# initOpenNextCloudflareForDev() in next.config.ts; run
# `wrangler d1 migrations apply woori-aroma-db --local` once first to
# seed the local D1 schema. See migrations/*.sql.

# How long a reservation HOLD stays reserved before it's eligible to be
# reused by another customer (see lib/repositories/reservationRepository.ts).
# Defaults to 10 minutes if unset.
# BOOKING_HOLD_MINUTES=10

# --- Notifications (lib/notifications) -------------------------------
# All notification env vars are server-only — never prefix with NEXT_PUBLIC_.
# Every provider below degrades cleanly ("provider_not_configured", logged,
# never a crash) when its variables are unset, so none of this is required
# for local development.

# Email — Resend (https://resend.com). Used for the automatic request-received/
# cancellation/reminder emails, and for manual sends from /admin/send-confirmation.
# The RESERVATION_CONFIRMED email for online reservations is never sent by the
# app itself — the admin composes and copies it from /admin/reservations/[id]
# and sends it by hand (Gmail, etc.).
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=

# Email delivery safety gate (lib/notifications/recipientPolicy.ts). Fail-safe
# by construction: ANY value other than exactly "production" — unset, empty,
# a typo — keeps the app in sandbox mode, where every automatically-sent email
# (request received / cancellation / reminder) and every manual send from
# /admin/send-confirmation is redirected to EMAIL_TEST_RECIPIENT instead of the
# real customer address. Only set EMAIL_DELIVERY_MODE=production on a
# deployment that must actually reach customers.
# EMAIL_DELIVERY_MODE=sandbox
#
# Required whenever EMAIL_DELIVERY_MODE is not "production" — sandbox sends
# are skipped entirely (never silently sent to the real customer) if this is
# unset. Also the fixed recipient for the admin's "Send Test Email" button,
# regardless of EMAIL_DELIVERY_MODE.
# EMAIL_TEST_RECIPIENT=

# 24h reminder scheduler (app/api/cron/reminders/route.ts). Required in
# production: the route rejects requests without this bearer token so the
# reminder job can't be triggered by anyone who finds the URL. Point any
# external scheduler (Vercel Cron, a server crontab, GitHub Actions, etc.) at
# this route with `Authorization: Bearer <CRON_SECRET>`.
# CRON_SECRET=
