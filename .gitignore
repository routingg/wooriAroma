# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# Stale local sqlite data from before the Cloudflare D1 migration — no code
# writes here anymore, but keep it out of git status if it still exists locally.
/.data/

# Cloudflare/Wrangler local state (local D1 SQLite, etc.) and OpenNext build output
/.wrangler/
/.open-next/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Playwright MCP debugging artifacts
/.playwright-mcp/
